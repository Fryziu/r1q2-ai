# Cross-compilation Makefile for 32-bit Windows (i686-w64-mingw32)
ROOT_DIR := $(abspath ..)
MINGW_CC ?= i686-w64-mingw32-gcc
MINGW_WINDRES ?= i686-w64-mingw32-windres
WIN32_OUT_DIR ?= $(abspath win32)
WIN32_DEPS_DIR ?= $(WIN32_OUT_DIR)/.deps
WIN32_BUILD_DIR ?= $(WIN32_OUT_DIR)/.build
USE_CURL ?= 1

COMMON_CFLAGS := -O2 -fno-strict-aliasing -ffloat-store -g \
	-DWIN32 -D_WINDOWS -DNDEBUG -D_M_IX86=1 -DC_ONLY=1 -DSDL_MAIN_HANDLED \
	-I$(WIN32_DEPS_DIR)/include -I$(WIN32_DEPS_DIR)/include/SDL2

SDL2_STATIC_LIBS := -L$(WIN32_DEPS_DIR)/lib -lSDL2-static -limm32 -lsetupapi -lversion -lole32 -loleaut32 -luuid -ldinput8

ifeq ($(USE_CURL),1)
CLIENT_CURL_CFLAGS := -DUSE_CURL=1 -DCURL_STATICLIB
CLIENT_CURL_LIBS := -L$(WIN32_DEPS_DIR)/lib -lcurl -lwldap32 -lcrypt32 -lsecur32 -lbcrypt
endif

CLIENT_SRCS := \
	client/cl_cin.c client/cl_ents.c client/cl_fx.c \
	client/cl_input.c client/cl_inv.c client/cl_main.c client/cl_newfx.c \
	client/cl_parse.c client/cl_pred.c client/cl_scrn.c client/cl_tent.c \
	client/cl_view.c client/console.c client/keys.c client/le_physics.c \
	client/le_util.c client/menu.c client/qmenu.c client/snd_dma.c \
	client/snd_mem.c client/snd_mix.c \
	qcommon/cmd.c qcommon/cmodel.c qcommon/common.c qcommon/crc.c \
	qcommon/cvar.c qcommon/files.c qcommon/ioapi.c qcommon/md4.c \
	qcommon/mersennetwister.c qcommon/net_chan.c qcommon/pmove.c \
	qcommon/redblack.c qcommon/unzip.c \
	server/sv_ccmds.c server/sv_ents.c server/sv_game.c server/sv_init.c \
	server/sv_main.c server/sv_send.c server/sv_user.c server/sv_world.c \
	game/m_flash.c game/q_shared.c \
	win32/cd_win.c win32/conproc.c \
	win32/net_wins.c win32/q_shwin.c \
	win32/sys_win.c \
	linux/vid_menu.c linux/vid_so.c linux/snd_sdl2.c

ifeq ($(USE_CURL),1)
CLIENT_SRCS += client/cl_http.c
endif

REF_GL_SRCS := \
	ref_gl/gl_draw.c ref_gl/gl_image.c ref_gl/gl_light.c ref_gl/gl_mesh.c \
	ref_gl/gl_model.c ref_gl/gl_rmain.c ref_gl/gl_rmisc.c ref_gl/gl_rsurf.c \
	ref_gl/gl_warp.c linux/gl_sdl2.c win32/q_shwin.c linux/qgl_linux.c \
	game/q_shared.c

GAME_SRCS := $(patsubst $(ROOT_DIR)/%,%,$(wildcard $(ROOT_DIR)/game/*.c))

CLIENT_OBJS := $(patsubst %.c,$(WIN32_BUILD_DIR)/client/%.o,$(notdir $(CLIENT_SRCS))) $(WIN32_BUILD_DIR)/client/q2_res.o
REF_GL_OBJS := $(patsubst %.c,$(WIN32_BUILD_DIR)/ref_gl/%.o,$(notdir $(REF_GL_SRCS)))
GAME_OBJS := $(patsubst %.c,$(WIN32_BUILD_DIR)/game/%.o,$(notdir $(GAME_SRCS)))

vpath %.c $(ROOT_DIR)/client $(ROOT_DIR)/qcommon $(ROOT_DIR)/server $(ROOT_DIR)/game $(ROOT_DIR)/win32 $(ROOT_DIR)/linux $(ROOT_DIR)/ref_gl

.PHONY: all clean

all: $(WIN32_OUT_DIR)/r1q2.exe $(WIN32_OUT_DIR)/ref_r1q2gl.dll $(WIN32_OUT_DIR)/r1q2_gamex86.dll

$(WIN32_BUILD_DIR)/client/%.o: %.c $(ROOT_DIR)/build.h
	@mkdir -p $(dir $@)
	$(MINGW_CC) $(COMMON_CFLAGS) $(CLIENT_CURL_CFLAGS) -c $< -o $@

$(WIN32_BUILD_DIR)/client/q2_res.o: $(ROOT_DIR)/win32/q2.rc
	@mkdir -p $(dir $@)
	$(MINGW_WINDRES) -I$(ROOT_DIR)/win32 -DWIN32 -DNDEBUG $< -o $@

$(WIN32_BUILD_DIR)/ref_gl/%.o: %.c
	@mkdir -p $(dir $@)
	$(MINGW_CC) $(COMMON_CFLAGS) -c $< -o $@

$(WIN32_BUILD_DIR)/game/%.o: %.c
	@mkdir -p $(dir $@)
	$(MINGW_CC) $(COMMON_CFLAGS) -DGAME_DLL -c $< -o $@

$(WIN32_OUT_DIR)/r1q2.exe: $(CLIENT_OBJS)
	@mkdir -p $(WIN32_OUT_DIR)
	$(MINGW_CC) -mwindows -o $@ $(CLIENT_OBJS) $(CLIENT_CURL_LIBS) $(SDL2_STATIC_LIBS) -Wl,-Bstatic -lz -Wl,-Bdynamic -lws2_32 -lwsock32 -lwinmm -lgdi32 -luser32 -ladvapi32 -lshell32 -ldbghelp -static-libgcc

$(WIN32_OUT_DIR)/ref_r1q2gl.dll: $(REF_GL_OBJS) $(ROOT_DIR)/ref_gl/ref_gl.def
	@mkdir -p $(WIN32_OUT_DIR)
	$(MINGW_CC) -shared -o $@ $(REF_GL_OBJS) $(ROOT_DIR)/ref_gl/ref_gl.def -L$(WIN32_DEPS_DIR)/lib -lpng -ljpeg $(SDL2_STATIC_LIBS) -Wl,-Bstatic -lz -Wl,-Bdynamic -lopengl32 -lgdi32 -luser32 -lwinmm -static-libgcc

$(WIN32_OUT_DIR)/r1q2_gamex86.dll: $(GAME_OBJS) $(ROOT_DIR)/game/game.def
	@mkdir -p $(WIN32_OUT_DIR)
	$(MINGW_CC) -shared -Wl,--image-base,0x20000000 -o $@ $(GAME_OBJS) $(ROOT_DIR)/game/game.def -lwinmm -lkernel32 -luser32 -static-libgcc

clean:
	rm -rf $(WIN32_BUILD_DIR) $(WIN32_OUT_DIR)/r1q2.exe $(WIN32_OUT_DIR)/ref_r1q2gl.dll $(WIN32_OUT_DIR)/r1q2_gamex86.dll
